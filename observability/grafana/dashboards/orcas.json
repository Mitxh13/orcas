{
  "uid": "orcas-platform",
  "title": "ORCAS Platform",
  "tags": ["orcas"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "End-to-end latency (p50 / p95)", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "orcas_run_latency_seconds", "legendFormat": "p{{quantile}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 2, "title": "Terminal success ratio", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "orcas_runs_success_ratio", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}},
    {"id": 3, "title": "Accepted complaints per second", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8}, "targets": [{"expr": "sum(rate(orcas_gateway_requests_total{route=\"/v1/complaints\",status=\"202\"}[5m]))", "refId": "A"}]},
    {"id": 4, "title": "Gateway 5xx per second", "type": "timeseries", "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8}, "targets": [{"expr": "sum(rate(orcas_gateway_requests_total{status=~\"5..\"}[5m]))", "refId": "A"}]},
    {"id": 5, "title": "Worker queue depth", "type": "timeseries", "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8}, "targets": [{"expr": "orcas_celery_queue_depth", "refId": "A"}]},
    {"id": 6, "title": "Step latency p95", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "orcas_run_step_latency_seconds{quantile=\"0.95\"}", "legendFormat": "{{step}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 7, "title": "LLM latency p95", "type": "timeseries", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(orcas_llm_latency_seconds_bucket[5m])))", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 8, "title": "Run cache hit ratio", "type": "timeseries", "gridPos": {"x": 0, "y": 24, "w": 8, "h": 8}, "targets": [{"expr": "sum(rate(orcas_gateway_run_cache_lookups_total{outcome=\"hit\"}[5m])) / clamp_min(sum(rate(orcas_gateway_run_cache_lookups_total{outcome=~\"hit|miss\"}[5m])), 0.0001)", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}},
    {"id": 9, "title": "Rate-limit rejections", "type": "timeseries", "gridPos": {"x": 8, "y": 24, "w": 8, "h": 8}, "targets": [{"expr": "orcas_gateway_rate_limit_rejections_total", "refId": "A"}]},
    {"id": 10, "title": "LLM cost (USD)", "type": "timeseries", "gridPos": {"x": 16, "y": 24, "w": 8, "h": 8}, "targets": [{"expr": "orcas_run_cost_usd", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "currencyUSD"}}},
    {"id": 11, "title": "Docker container CPU", "type": "timeseries", "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8}, "targets": [{"expr": "sum by (id) (rate(container_cpu_usage_seconds_total{id=~\".*(/docker/|/docker-)[0-9a-f]+([.]scope)?\"}[5m]))", "legendFormat": "{{id}}", "refId": "A"}]},
    {"id": 12, "title": "Docker container memory", "type": "timeseries", "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8}, "targets": [{"expr": "container_memory_working_set_bytes{id=~\".*(/docker/|/docker-)[0-9a-f]+([.]scope)?\"}", "legendFormat": "{{id}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 13, "title": "Feedback ratings", "type": "timeseries", "gridPos": {"x": 0, "y": 40, "w": 8, "h": 8}, "targets": [{"expr": "orcas_feedback", "legendFormat": "{{rating}}", "refId": "A"}]},
    {"id": 14, "title": "Quality scores", "type": "timeseries", "gridPos": {"x": 8, "y": 40, "w": 8, "h": 8}, "targets": [{"expr": "orcas_eval_score", "legendFormat": "{{metric}}", "refId": "A"}]},
    {"id": 15, "title": "LLM tokens", "type": "timeseries", "gridPos": {"x": 16, "y": 40, "w": 8, "h": 8}, "targets": [{"expr": "orcas_run_tokens", "legendFormat": "{{direction}}", "refId": "A"}]},
    {"id": 16, "title": "Index age", "type": "timeseries", "gridPos": {"x": 0, "y": 48, "w": 8, "h": 8}, "targets": [{"expr": "time() - orcas_index_built_timestamp", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 17, "title": "Verifier retries", "type": "timeseries", "gridPos": {"x": 8, "y": 48, "w": 8, "h": 8}, "targets": [{"expr": "orcas_run_retries", "refId": "A"}]},
    {"id": 18, "title": "Tool calls per run", "type": "timeseries", "gridPos": {"x": 16, "y": 48, "w": 8, "h": 8}, "targets": [{"expr": "orcas_run_tool_calls_per_run", "refId": "A"}]},
    {"id": 19, "title": "LLM breaker open", "type": "timeseries", "gridPos": {"x": 0, "y": 56, "w": 8, "h": 8}, "targets": [{"expr": "orcas_llm_breaker_open", "refId": "A"}]},
    {"id": 20, "title": "Cost per 100 terminal runs", "type": "timeseries", "gridPos": {"x": 8, "y": 56, "w": 8, "h": 8}, "targets": [{"expr": "orcas_cost_per_100_runs_usd", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "currencyUSD"}}},
    {"id": 21, "title": "Work events per run", "type": "timeseries", "gridPos": {"x": 16, "y": 56, "w": 8, "h": 8}, "targets": [{"expr": "orcas_run_steps_per_run", "refId": "A"}]},
    {"id": 22, "title": "Service availability (5m)", "type": "timeseries", "gridPos": {"x": 0, "y": 64, "w": 8, "h": 8}, "targets": [{"expr": "avg_over_time(up{job=~\"gateway|retrieval|llm-gateway|worker-metrics|cadvisor\"}[5m])", "legendFormat": "{{job}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}},
    {"id": 23, "title": "LLM tokens by step", "type": "timeseries", "gridPos": {"x": 8, "y": 64, "w": 8, "h": 8}, "targets": [{"expr": "orcas_run_tokens_by_step", "legendFormat": "{{step}} {{direction}}", "refId": "A"}]},
    {"id": 24, "title": "LLM cost by step", "type": "timeseries", "gridPos": {"x": 16, "y": 64, "w": 8, "h": 8}, "targets": [{"expr": "orcas_run_cost_by_step_usd", "legendFormat": "{{step}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "currencyUSD"}}}
  ]
}
