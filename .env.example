# ==========================================
# ORCAS Configuration Template (.env.example)
# Copy this file to .env and fill in required values
# ==========================================

# --- LLM Provider & Gateway Configuration ---
# Choose provider supported by LiteLLM (e.g., openai, anthropic, gemini, groq, mistral, ollama)
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-1.5-flash
LLM_API_KEY=
LLM_FALLBACK_MODEL=groq/llama-3.1-8b-instant
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=15
LLM_GATEWAY_URL=http://llm-gateway:8002

# --- Stub Mode (for load testing without provider API limits) ---
# The initial demo runs against the deterministic LLM stub without an API key.
ORCAS_STUB_MODE=true
STUB_DELAY_MS=1500

# --- Worker & Agent Bounded Loops ---
MAX_STEPS=10
MAX_TOOL_CALLS=8
RUN_WALL_CLOCK_S=45
MAX_VERIFY_RETRIES=2

# --- Circuit Breaker (Shared in Redis) ---
BREAKER_FAILURES=3
BREAKER_COOLDOWN_S=30

# --- Retrieval & Vector Store ---
RETRIEVAL_SERVICE_URL=http://retrieval:8001
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=/chroma_data
CHROMA_HOST=retrieval
CHROMA_PORT=8001

# --- State & Persistence ---
POSTGRES_USER=orcas
POSTGRES_PASSWORD=orcas_demo_only
POSTGRES_DB=orcas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://orcas:orcas_demo_only@postgres:5432/orcas

# --- Caching, Rate Limiting & Queue ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
RUN_CACHE_TTL_S=3600
RATE_LIMIT_PER_MIN=60
ORCAS_ADMIN_TOKEN=

# --- Live Quality Scoring & Evaluation ---
LIVE_SCORE_SAMPLE_RATE=0.1

# --- Observability & Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=orcas
LOG_LEVEL=INFO
