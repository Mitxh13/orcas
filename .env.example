# ==========================================
# ORCAS Configuration Template (.env.example)
# Copy this file to .env and fill in required values
# ==========================================

# --- LLM Provider & Gateway Configuration ---
# Set a LiteLLM provider and model when ORCAS_STUB_MODE=false.
# Model format: <provider>/<model>. Leave the values empty for stub mode.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_API_KEY=
LLM_TEMPERATURE=0.0
# One provider attempt may take LLM_TIMEOUT_SECONDS. All attempts, backoff waits (a 429's
# Retry-After is honoured) and the fallback call share LLM_TOTAL_BUDGET_SECONDS. The worker waits
# that budget plus 10 s, so keep: LLM_TIMEOUT_SECONDS < LLM_TOTAL_BUDGET_SECONDS < CELERY_SOFT_TIME_LIMIT.
# A slow local model needs all three raised together, and RUN_WALL_CLOCK_S with them.
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_BUDGET_SECONDS=90
# Ask the provider for a JSON object; providers without the option ignore it.
LLM_JSON_MODE=true
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0
LLM_FALLBACK_PRICE_INPUT_PER_M=0
LLM_FALLBACK_PRICE_OUTPUT_PER_M=0
# Inside Compose. From the host (make eval-live, make experiment) use http://localhost:8002.
LLM_GATEWAY_URL=http://llm-gateway:8002
LLM_FORCE_FAIL=0

# --- Stub Mode (for load testing without provider API limits) ---
# The initial demo runs against the deterministic LLM stub without an API key.
ORCAS_STUB_MODE=true
STUB_DELAY_MS=1500

# --- Worker & Agent Bounded Loops ---
MAX_STEPS=10
MAX_TOOL_CALLS=8
RUN_WALL_CLOCK_S=45
MAX_VERIFY_RETRIES=2
# classify v3 reports regulators_involved (split-regulator escalation). draft v2 has the model
# cite numbered evidence and is the "after" arm of the l3-cite-by-evidence-number experiment.
PROMPT_RESEARCHER_CLASSIFY=v3
PROMPT_RESEARCHER_REFLECT=v2
PROMPT_RESEARCHER_DRAFT=v1
PROMPT_VERIFIER=v1
ORCAS_INJECT_BAD_DRAFT=0
CELERY_SOFT_TIME_LIMIT=120
CELERY_TIME_LIMIT=180

# --- Circuit Breaker (Shared in Redis) ---
BREAKER_FAILURES=3
BREAKER_COOLDOWN_S=30

# --- Retrieval & Vector Store ---
RETRIEVAL_SERVICE_URL=http://retrieval:8001
RETRIEVAL_TIMEOUT_S=10
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- State & Persistence ---
POSTGRES_USER=orcas
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=orcas

# --- Caching, Rate Limiting & Queue ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
RUN_CACHE_TTL_S=3600
RATE_LIMIT_PER_MIN=60
ORCAS_ADMIN_TOKEN=

# --- Live Quality Scoring & Evaluation ---
LIVE_SCORE_SAMPLE_RATE=0.2

# --- Observability & Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
LOG_LEVEL=INFO
